<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tf_tree_ros</name>
  <!-- Hand-kept copy of the root Cargo.toml's [workspace.package] version;
       that file carries the argument for the number. -->
  <version>0.0.5</version>
  <description>
    The tf_tree ROS 2 ingest bridge (docs/PHASE4.md §5): subscribes /tf and
    /tf_static and writes into a tf_tree arena. Ingress only — it never
    publishes.
  </description>
  <maintainer email="noe.fontana.pro@gmail.com">Noe Fontana</maintainer>
  <license>MIT OR Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>geometry_msgs</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>tf2_msgs</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <!-- test only: `test_clock.cpp` publishes `/clock` to exercise §5.5's
       authoritative jump path. The library itself never touches it — it reads
       the time source through `rclcpp::Clock`, not through the message. -->
  <test_depend>rosgraph_msgs</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
